# Environment (contains secrets)
.env

# Local Apex API notes (contains device IP, serial — use .example template)
docs/apex-api-notes.md
docs/apex-api-notes.md.bak

# Real device captures in testdata (may contain IPs, serials, etc.) — exclude by convention
# Files named *.real.json or *.capture.json are real device responses; everything else is a committed fixture
testdata/*.real.json
testdata/*.capture.json

# Database files
*.db
*.db-shm
*.db-wal
*.db.wal
*.db.shm

# Backup directory
backups/

# Frontend build output
frontend/dist/
frontend/node_modules/

# Compiled binaries
/poller
/api
/mcp
/symbiont

# Go build cache
/vendor/

# Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Nix
result
result-*

# direnv (local shell environment, may contain secrets)
.direnv/
.envrc

# Uploaded images (runtime data)
images/
